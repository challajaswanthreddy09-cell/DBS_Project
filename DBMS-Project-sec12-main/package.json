{
  "name": "dbms-library-project",
  "version": "1.0.0",
  "description": "Library Management System with RFID Integration",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "start:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,cyan\" \"npm run start:backend\" \"npm run start:frontend\"",
    "build:frontend": "npm run build --prefix frontend"
  },
  "keywords": [
    "library-management",
    "rfid",
    "react",
    "nodejs",
    "express",
    "mysql"
  ],
  "author": "Sidhartha",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
